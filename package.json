{
  "name": "empyrean-upgrades",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && bun run scripts/postbuild.ts",
    "preview": "vite preview --outDir build/client --port 4181 --strictPort",
    "preview:worker": "bun run build && wrangler dev --port 8788",
    "test": "playwright test",
    "test:unit": "bun test app scripts worker",
    "visits": "bun run scripts/visits.ts",
    "feedback": "bun run scripts/feedback.ts",
    "ledger": "bun run scripts/ledger.ts",
    "test:ui": "playwright test --ui",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "react-router typegen && tsc",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/cormorant": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@react-router/node": "^8.1.0",
    "isbot": "^5.1.44",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "^8.1.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.57.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "wrangler": "^4.151.3"
  }
}
